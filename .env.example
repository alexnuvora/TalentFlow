VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_APP_NAME=TalentFlow Recruitment
VITE_APP_URL=http://localhost:5173
VITE_LEGAL_NAME=Your Recruitment Company Ltd
VITE_LEGAL_ADDRESS=Registered office address, United Kingdom
