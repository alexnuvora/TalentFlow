# Required browser configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Recommended public application configuration
VITE_APP_NAME=TalentFlow Recruitment
VITE_APP_URL=http://localhost:5173
VITE_CANDIDATE_RETENTION_MONTHS=6

# Optional search engine ownership verification tokens
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Optional legal/contact identity. Leave unset until genuine details exist.
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_PRIVACY_EMAIL=

# AI, email, SMS and automation credentials run in Supabase Edge Functions,
# not in Vite/Vercel browser variables. See supabase/functions/.env.example.
# Never prefix private credentials with VITE_.
