# Supabase Edge Function secrets, NOT Vercel frontend variables.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Required for AI screening. Provider must implement POST /chat/completions.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Required for invitations, checkout return URLs and server-generated links.
PUBLIC_APP_URL=https://talentflow-nu-neon.vercel.app

# Required for client-submission, invoice delivery and email automation.
RESEND_API_KEY=
RESEND_FROM=

# Optional: only required when SMS or WhatsApp automation channels are used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Required only to activate SaaS card subscriptions through Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# AUTOMATION_CRON_SECRET is no longer an Edge Function env var.
# Production rotates an internal scheduler secret in Postgres, stores it in Supabase Vault,
# and validates only its SHA-256 hash from the automation worker.

# Legacy aliases supported by AI screening if already configured:
# OPENAI_API_KEY=
# OPENAI_MODEL=
