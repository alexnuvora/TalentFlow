# Supabase Edge Function secrets, NOT Vercel frontend variables.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Required for AI screening. Provider must implement POST /chat/completions.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Required for invitations and links generated by server functions.
PUBLIC_APP_URL=https://talentflow-nu-neon.vercel.app

# Required for client-submission and email automation delivery.
RESEND_API_KEY=
RESEND_FROM=

# Required for the protected automation worker/scheduler.
AUTOMATION_CRON_SECRET=

# Optional: only required when SMS or WhatsApp automation channels are used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Legacy aliases supported by AI screening if already configured:
# OPENAI_API_KEY=
# OPENAI_MODEL=
