{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/oauth/provider/callback",
      "destination": "https://mzkaodoruhklzluikagy.supabase.co/functions/v1/provider-oauth/callback"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/services/ai-automation",
      "destination": "/services/permanent-recruitment",
      "permanent": true
    },
    {
      "source": "/services/web-applications",
      "destination": "/employers",
      "permanent": true
    },
    {
      "source": "/services/web-design-development",
      "destination": "/employers",
      "permanent": true
    },
    {
      "source": "/work/:path*",
      "destination": "/employers",
      "permanent": true
    }
  ]
}
